# Copy to .env (gitignored). Do not commit real keys.
GEMINI_API_KEY=

# Snowflake REST (PAT). Trial only — no credit card, never click Upgrade.
# Host is org-account from Snowsight, e.g. myorg-myaccount
#   https://<SNOWFLAKE_ACCOUNT>.snowflakecomputing.com/api/v2/databases
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
# Optional; only needed for SQL statements (can resume an X-Small warehouse).
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_SQL=
