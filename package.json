{
  "name": "isotope",
  "version": "0.1.0",
  "private": true,
  "description": "Isotope Phase 1: contracts and scaffold only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "tsc -b && node tools/export-schemas.cjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.cjs",
    "isotope": "pnpm --silent build && node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "20.17.30",
    "@isotope/core": "workspace:*",
    "@isotope/changespec": "workspace:*",
    "@isotope/resolver-ts": "workspace:*",
    "@isotope/resolver-py": "workspace:*",
    "@isotope/harness-ts": "workspace:*",
    "@isotope/harness-py": "workspace:*",
    "@isotope/differ": "workspace:*",
    "@isotope/reasoner": "workspace:*",
    "@isotope/repair": "workspace:*",
    "@isotope/verifier": "workspace:*",
    "@isotope/reporter": "workspace:*",
    "@isotope/fleet": "workspace:*",
    "@isotope/cli": "workspace:*"
  }
}
