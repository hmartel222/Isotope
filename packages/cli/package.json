{
  "name": "@isotope/cli",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isotope/core": "workspace:*",
    "commander": "12.1.0",
    "yaml": "2.7.1",
    "@isotope/changespec": "workspace:*",
    "@isotope/harness-ts": "workspace:*",
    "@isotope/differ": "workspace:*",
    "@isotope/resolver-ts": "workspace:*",
    "@isotope/repair": "workspace:*",
    "@isotope/verifier": "workspace:*",
    "@isotope/reasoner": "workspace:*"
  },
  "bin": {
    "isotope": "bin/isotope.cjs"
  }
}
