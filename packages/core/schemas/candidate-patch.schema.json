{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "abstain": {
          "type": "boolean"
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "causalChain": {
          "minLength": 1,
          "type": "string"
        },
        "classification": {
          "const": "repair_candidate",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "const": "high",
              "type": "string"
            },
            {
              "const": "medium",
              "type": "string"
            },
            {
              "const": "low",
              "type": "string"
            }
          ]
        },
        "evidenceRefs": {
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "code",
                    "type": "string"
                  },
                  "line": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "file",
                  "line"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "dataflow",
                    "type": "string"
                  },
                  "nodeId": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "nodeId"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "diff",
                    "type": "string"
                  },
                  "pointer": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "pointer"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "artifact",
                    "type": "string"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "humanQuestion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "const": "deterministic",
              "type": "string"
            },
            {
              "const": "model",
              "type": "string"
            }
          ]
        },
        "patch": {
          "additionalProperties": false,
          "properties": {
            "files": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "edits": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "anchor": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "replacement": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "anchor",
                        "replacement"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "edits"
                ],
                "type": "object"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "files"
          ],
          "type": "object"
        },
        "repairId": {
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        },
        "suspectedInjection": {
          "type": "boolean"
        }
      },
      "required": [
        "repairId",
        "confidence",
        "summary",
        "causalChain",
        "assumptions",
        "evidenceRefs",
        "humanQuestion",
        "suspectedInjection",
        "abstain",
        "origin",
        "classification",
        "patch"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "abstain": {
          "type": "boolean"
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "causalChain": {
          "minLength": 1,
          "type": "string"
        },
        "classification": {
          "anyOf": [
            {
              "const": "human_decision_required",
              "type": "string"
            },
            {
              "const": "no_safe_repair",
              "type": "string"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "const": "high",
              "type": "string"
            },
            {
              "const": "medium",
              "type": "string"
            },
            {
              "const": "low",
              "type": "string"
            }
          ]
        },
        "evidenceRefs": {
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "code",
                    "type": "string"
                  },
                  "line": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "file",
                  "line"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "dataflow",
                    "type": "string"
                  },
                  "nodeId": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "nodeId"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "diff",
                    "type": "string"
                  },
                  "pointer": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "pointer"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "artifact",
                    "type": "string"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "humanQuestion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "const": "deterministic",
              "type": "string"
            },
            {
              "const": "model",
              "type": "string"
            }
          ]
        },
        "patch": {
          "type": "null"
        },
        "repairId": {
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        },
        "suspectedInjection": {
          "type": "boolean"
        }
      },
      "required": [
        "repairId",
        "confidence",
        "summary",
        "causalChain",
        "assumptions",
        "evidenceRefs",
        "humanQuestion",
        "suspectedInjection",
        "abstain",
        "origin",
        "classification",
        "patch"
      ],
      "type": "object"
    }
  ],
  "definitions": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "array"
        },
        {
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/definitions/JsonValue"
            }
          },
          "type": "object"
        }
      ]
    }
  }
}
