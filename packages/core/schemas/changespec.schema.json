{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "array"
        },
        {
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/definitions/JsonValue"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "ambiguity": {
            "additionalProperties": false,
            "properties": {
              "options": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "question": {
                "minLength": 1,
                "type": "string"
              },
              "when": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "when",
              "question",
              "options"
            ],
            "type": "object"
          },
          "applies_to_events": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "codemod": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "path_rename",
                    "type": "string"
                  },
                  "safe_when": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "to": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "safe_when",
                  "from",
                  "to"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "unsupported",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              }
            ]
          },
          "object": {
            "minLength": 1,
            "type": "string"
          },
          "removed_path": {
            "minLength": 1,
            "type": "string"
          },
          "removed_symbol": {
            "minLength": 1,
            "type": "string"
          },
          "repair_policy": {
            "additionalProperties": false,
            "properties": {
              "business_policy_required_when": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "business_policy_required_when"
            ],
            "type": "object"
          },
          "replacement": {
            "additionalProperties": false,
            "properties": {
              "cardinality": {
                "anyOf": [
                  {
                    "const": "one",
                    "type": "string"
                  },
                  {
                    "const": "many",
                    "type": "string"
                  }
                ]
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "semantics": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path",
              "cardinality"
            ],
            "type": "object"
          }
        },
        "required": [
          "object",
          "replacement"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "detection": {
      "additionalProperties": false,
      "properties": {
        "ecosystems": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^(npm|pypi)$": {
              "additionalProperties": false,
              "properties": {
                "breaking_from": {
                  "minLength": 1,
                  "type": "string"
                },
                "packages": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "packages",
                "breaking_from"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "taint_roots": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "call",
                    "type": "string"
                  },
                  {
                    "const": "type",
                    "type": "string"
                  }
                ]
              },
              "language": {
                "anyOf": [
                  {
                    "const": "ts",
                    "type": "string"
                  },
                  {
                    "const": "py",
                    "type": "string"
                  }
                ]
              },
              "pattern": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "language",
              "pattern"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "ecosystems",
        "taint_roots"
      ],
      "type": "object"
    },
    "fixtures": {
      "additionalProperties": false,
      "properties": {
        "adaptation_pair": {
          "minLength": 1,
          "type": "string"
        },
        "ambiguity_pair": {
          "minLength": 1,
          "type": "string"
        },
        "heldout_pair": {
          "minLength": 1,
          "type": "string"
        },
        "noop_pair": {
          "minLength": 1,
          "type": "string"
        },
        "pair": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "pair"
      ],
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "semantics": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "verified_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "verified_by": {
      "anyOf": [
        {
          "const": "human",
          "type": "string"
        },
        {
          "const": "draft",
          "type": "string"
        }
      ]
    },
    "versions": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "minLength": 1,
          "type": "string"
        },
        "to": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "provider",
    "title",
    "source",
    "verified_by",
    "versions",
    "semantics",
    "detection",
    "changes",
    "fixtures"
  ],
  "type": "object"
}
