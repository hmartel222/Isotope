{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "array"
        },
        {
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/definitions/JsonValue"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "basis": {
      "anyOf": [
        {
          "const": "provider_call",
          "type": "string"
        },
        {
          "const": "provider_type",
          "type": "string"
        },
        {
          "const": "one_hop_parameter",
          "type": "string"
        },
        {
          "const": "reexport",
          "type": "string"
        },
        {
          "const": "name_heuristic",
          "type": "string"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "const": "high",
          "type": "string"
        },
        {
          "const": "medium",
          "type": "string"
        },
        {
          "const": "low",
          "type": "string"
        }
      ]
    },
    "evidenceRefs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "rootNodeId": {
      "minLength": 1,
      "type": "string"
    },
    "specId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "confidence",
    "provider",
    "specId",
    "basis"
  ],
  "type": "object"
}
