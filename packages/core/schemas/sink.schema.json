{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "array"
        },
        {
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/definitions/JsonValue"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "kind": {
      "anyOf": [
        {
          "const": "db_write",
          "type": "string"
        },
        {
          "const": "http_out",
          "type": "string"
        },
        {
          "const": "queue",
          "type": "string"
        },
        {
          "const": "email",
          "type": "string"
        },
        {
          "const": "returned_state",
          "type": "string"
        },
        {
          "const": "log_only",
          "type": "string"
        }
      ]
    },
    "location": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minimum": 1,
          "type": "integer"
        },
        "endLine": {
          "minimum": 1,
          "type": "integer"
        },
        "file": {
          "minLength": 1,
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line"
      ],
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "nodeId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "nodeId",
    "kind",
    "name",
    "location"
  ],
  "type": "object"
}
