{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "array"
        },
        {
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/definitions/JsonValue"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "from": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "flows_to",
      "type": "string"
    },
    "pathSuffix": {
      "type": "string"
    },
    "to": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "from",
    "to",
    "kind",
    "pathSuffix"
  ],
  "type": "object"
}
