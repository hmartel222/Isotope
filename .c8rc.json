{
  "all": true,
  "src": [
    "packages/differ/src",
    "packages/core/src"
  ],
  "include": [
    "packages/differ/src/**/*.ts",
    "packages/core/src/verdict.ts"
  ],
  "exclude": [],
  "reporter": [
    "text",
    "json-summary",
    "html"
  ],
  "reports-dir": ".isotope/coverage",
  "check-coverage": true,
  "per-file": true,
  "branches": 90,
  "lines": 90,
  "functions": 90,
  "statements": 90,
  "exclude-after-remap": true
}
